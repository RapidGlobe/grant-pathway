# =============================================================================
# Grant Pathway v1 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.
#
# Note (D29): ADR-SEC-006 lists only the 6 Supabase/AWS variables.
# This file is the authoritative list — UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN, CRON_SECRET, and SENTRY_DSN are also required.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# Found in: Supabase dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase — server only (never expose to the browser)
# Found in: Supabase dashboard → Settings → API → service_role key
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Supabase — database password (server only, never expose to the browser)
# Required for Supabase CLI operations: supabase db push, supabase db pull,
# supabase migration new, and connecting directly via psql.
# Found in: Supabase dashboard → Settings → Database → Database password
# Note: this is different from the anon/service_role API keys above.
# (ADR-DATA-004, GAP-06)
# -----------------------------------------------------------------------------
SUPABASE_DB_PASSWORD=

# -----------------------------------------------------------------------------
# AWS — server only
# Used for Amazon Bedrock Claude calls (eu-west-2)
# Found in: AWS console → IAM → your Bedrock user → Security credentials
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2

# -----------------------------------------------------------------------------
# Upstash Redis — server only
# Used for AI route rate limiting (P3.6)
# Found in: Upstash console → your Redis database → REST API
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Cron secret — server only
# A random secret used to authenticate Vercel cron job requests
# Generate with: openssl rand -base64 32 (or any strong random string)
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Sentry — server only + public
# Used for error tracking (P3.7)
# Found in: Sentry dashboard → Settings → Projects → your project → Client Keys (DSN)
# Both variables use the same DSN value
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Charity Commission API — server only
# Used for charity name/number lookup on the /profile page (S1.1 / FR-10)
# Register at: https://register-of-charities.charitycommission.gov.uk/register/full-register-download
# or via the API developer portal at https://api.charitycommission.gov.uk/
# The key is sent as the Ocp-Apim-Subscription-Key request header.
# If this variable is not set, the lookup will return 'unavailable' gracefully.
# -----------------------------------------------------------------------------
CHARITY_COMMISSION_API_KEY=

# -----------------------------------------------------------------------------
# Resend — server only
# Used for transactional email (inactivity warnings, deletions)
# Found in: Resend dashboard → API Keys
# Supabase Auth SMTP uses the same key (entered directly in Supabase dashboard)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
